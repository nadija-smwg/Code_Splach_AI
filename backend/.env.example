# Backend Environment Variables — ClearanceX
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env to the repository.

# Gemini AI API Key (required for real AI pipeline)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use
GEMINI_MODEL=gemini-2.0-flash

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/clearancex

# CORS — comma-separated list of allowed frontend origins
# Default covers local dev. In Docker, add your frontend container origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
